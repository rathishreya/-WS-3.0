%% PLATFORM flow (generic). Text in (EZ: ...) shows how Tenant-Zero CONFIGURES each step —
%% it is illustration, NOT platform structure. Nothing EZ-specific is baked in.
flowchart TD
  classDef form fill:#E8ECFB,stroke:#3B5BDB,color:#12162a;
  classDef sys fill:#EFF1F5,stroke:#9aa1ad,color:#191C22;
  classDef dec fill:#F7ECD6,stroke:#B7791F,color:#3a2c0a;
  classDef state fill:#E4F3EC,stroke:#2F9E6B,color:#123a25;
  classDef rework fill:#F8E6E1,stroke:#C6503C,color:#3a1712;

  %% ========== 1. ONBOARD ORGANIZATION ==========
  subgraph ONB["1 · ONBOARD ORGANIZATION  (platform operator)"]
    START(["Start: New Organization"]):::state --> A1[/"FORM: org, deployment tier, modules, admin email"/]:::form
    A1 --> A2["System creates workspace + emails admin invite"]:::sys
    A2 --> A3["Admin logs in to the Setup checklist"]:::sys
  end

  %% ========== 2. CONFIGURE WORKSPACE ==========
  subgraph CFG["2 · CONFIGURE WORKSPACE  (workspace admin) — configure ANYTHING, until it can deliver"]
    A3 --> B1[/"FORM: operating entity (currency, tax, prefix)"/]:::form
    B1 --> B2[/"FORM: define teams & roles<br/>(EZ configures: SWAT / QA / SME / pool)"/]:::form
    B2 --> B3[/"FORM: catalog offering + delivery model + billing model + price"/]:::form
    B3 --> B4[/"FORM: skills + pricing/value units<br/>(EZ configures: coins/credits + rate list)"/]:::form
    B4 --> B5[/"FORM: pricing records / codes + payment type"/]:::form
    B5 --> B6[/"INVITE people to join, accept, set profile + skills"/]:::form
    B6 --> B7{"Prepaid billing?"}:::dec
    B7 -->|"Yes"| B8[/"FORM: fund wallet"/]:::form
    B7 -->|"No"| B9
    B8 --> B9{"Readiness check: everything present?"}:::dec
    B9 -->|"No — checklist shows gaps"| B1
    B9 -->|"Yes"| READY(["WORKSPACE OPERATIONAL"]):::state
  end

  %% ========== 3. REQUEST IN ==========
  subgraph INT["3 · A REQUEST COMES IN"]
    READY --> C0{"Intake channel (adapter)"}:::dec
    C0 -->|"Manual"| C1[/"FORM: brief + files + deadline + entity"/]:::form
    C0 -->|"Email"| C1b["Monitored inbox auto-creates the request"]:::sys
    C0 -->|"External tool"| C1c["Client tool (EZ: Phrase) syncs into a request"]:::sys
    C1 --> C2
    C1b --> C2
    C1c --> C2["Ambient AI maps brief to offering + level"]:::sys
    C2 --> C3{"AI confident?"}:::dec
    C3 -->|"Ambiguous — ask 'X or Y?'"| C4["User picks / edits"]:::form
    C3 -->|"Confident"| C5
    C4 --> C5["Requester approves the mapped service"]:::sys
  end

  %% ========== 4. SET UP THE WORK ==========
  subgraph SET["4 · SET UP THE WORK  (owner/ops role — EZ: SWAT)"]
    C5 --> D1["Owner creates the assignment"]:::sys
    D1 --> D2{"Pricing/code valid? Wallet funded if prepaid?"}:::dec
    D2 -->|"No"| D2x["Blocked: fix pricing / fund wallet"]:::rework
    D2x --> D1
    D2 -->|"Yes, prepaid"| D3["Wallet debited"]:::sys
    D2 -->|"Yes, postpaid"| D4
    D3 --> D4["Split file into activities per the offering's skill-chain<br/>(EZ translation: TR to PR to QA) + Delivery activity"]:::sys
    D4 --> D5{"Dependencies between activities?"}:::dec
    D5 -->|"Yes"| D6["Chain output to input; add nested sub-assignments"]:::sys
    D5 -->|"No"| D7
    D6 --> D7{"Deliverable, or ongoing service?"}:::dec
    D7 -->|"Ongoing (retainer / outcome)"| D8["Create engagement, bind committed team, open service period"]:::sys
    D7 -->|"Deliverable"| ALLOC
    D8 --> ALLOC
  end

  %% ========== 5. ALLOCATE & PERFORM ==========
  subgraph PERF["5 · ALLOCATE & PERFORM"]
    ALLOC["Owner allocates activity; AI proposes best-fit performer"]:::sys --> P1{"Performer type?"}:::dec
    P1 -->|"AI agent"| P2["Agent runs (EZ: Flip / MT / OCR) then outputs a first pass"]:::sys
    P1 -->|"Human + tool"| P3["Mandated tool assigned (EZ: TR42 / Canva); person works"]:::form
    P1 -->|"Human"| P4["Notify performer channel-native (WhatsApp/SMS one-tap accept)"]:::sys
    P4 --> P5{"Performer accepts?"}:::dec
    P5 -->|"Rejects (reason)"| ALLOC
    P5 -->|"Accepts"| P6["Activity published; request goes LIVE"]:::sys
    P6 --> WK
    P3 --> WK
    WK[/"Performer does the work + logs progress"/]:::form --> WI{"Interim draft to show requester?"}:::dec
    WI -->|"Yes"| WI2["Interim delivery; requester reviews / approves"]:::sys
    WI2 --> WK
    WI -->|"Final output"| RV
    P2 --> RV
  end

  %% ========== 6. REVIEW, DELIVER, VERIFY ==========
  subgraph DEL["6 · REVIEW · DELIVER · VERIFY"]
    RV["Review role checks the output (EZ: QA layer)"]:::sys --> QG{"Review pass?"}:::dec
    QG -->|"Fail — rework"| WK
    QG -->|"Pass"| DA["All activities done; assignment auto-delivers up the tree"]:::sys
    DA --> OB["Owner signs off at the boundary (mandatory review)"]:::sys
    OB --> DC["Deliver to the requester's store"]:::sys
    DC --> CAP{"Requester approves?"}:::dec
    CAP -->|"Rejects — rework"| WK
    CAP -->|"Approves"| VF{"Verifier signs off? (Verify gate — EZ: SWAT TL)"}:::dec
    VF -->|"Fail — fix"| WK
    VF -->|"Verified"| VOK(["Verified"]):::state
  end

  %% ========== 7. BILL & PAY ==========
  subgraph BILL["7 · BILL & PAY  (only after Verify — rolling)"]
    VOK --> M1["Invoice raised + performer payout (per billing model)"]:::sys
    M1 --> M2{"Ongoing engagement?"}:::dec
    M2 -->|"Yes — next period opens"| D8
    M2 -->|"No"| M3{"Recurring request?"}:::dec
    M3 -->|"Yes — new cycle"| C2
    M3 -->|"No"| DONE(["Delivered · billed · paid"]):::state
    DONE --> GW{"Goodwill revision requested later?"}:::dec
    GW -->|"Yes"| GW2["New linked assignment (no claw-back)"]:::sys
    GW2 --> ALLOC
    GW -->|"No"| CLOSED(["Closed"]):::state
  end

  %% ========== 8. CHANGE HANDLING (can trigger from any live state) ==========
  subgraph CHG["8 · CHANGE HANDLING  (can trigger from any in-flight state; policy is tenant-config)"]
    LIVE(["Any live activity / assignment"]):::state --> CH{"Change type?"}:::dec
    CH -->|"Scope change"| CH1["Re-quote; requester re-approves; verifier confirms"]:::rework
    CH -->|"Reassign (performer unavailable)"| CH2["Handover; fee-split per policy"]:::rework
    CH -->|"Pause"| CH3["Assignment paused"]:::rework
    CH -->|"Cancel"| CH4["Sunk work paid per policy; wallet refund"]:::rework
    CH -->|"Dispute raised"| CH5["Ops resolves; adjust invoice / payout"]:::rework
    CH1 --> RES(["Resume flow"]):::state
    CH2 --> RES
    CH3 --> RES
    CH5 --> RES
    CH4 --> TERM(["Terminated"]):::state
  end
