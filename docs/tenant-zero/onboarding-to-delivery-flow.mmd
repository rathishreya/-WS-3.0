flowchart TD
  classDef form fill:#E8ECFB,stroke:#3B5BDB,color:#12162a;
  classDef sys fill:#EFF1F5,stroke:#9aa1ad,color:#191C22;
  classDef dec fill:#F7ECD6,stroke:#B7791F,color:#3a2c0a;
  classDef state fill:#E4F3EC,stroke:#2F9E6B,color:#123a25;
  classDef rework fill:#F8E6E1,stroke:#C6503C,color:#3a1712;

  %% ========== 1. ONBOARD ORGANIZATION ==========
  subgraph ONB["1 · ONBOARD ORGANIZATION  (platform operator)"]
    START(["Start: New Organization"]):::state --> A1[/"FORM: org, deployment tier, modules, admin email"/]:::form
    A1 --> A2["System creates workspace + emails admin invite"]:::sys
    A2 --> A3["Admin logs in to the Setup checklist"]:::sys
  end

  %% ========== 2. CONFIGURE WORKSPACE ==========
  subgraph CFG["2 · CONFIGURE WORKSPACE  (WS admin) — until it can deliver"]
    A3 --> B1[/"FORM: operating entity (currency, tax, prefix)"/]:::form
    B1 --> B2[/"FORM: teams (SWAT / QA / SME / pool)"/]:::form
    B2 --> B3[/"FORM: catalog offering + delivery model + billing model + price"/]:::form
    B3 --> B4[/"FORM: skills + rate list (Delivery skill auto-added)"/]:::form
    B4 --> B5[/"FORM: pricing / invoice codes + payment type"/]:::form
    B5 --> B6[/"INVITE people to join, accept, set profile + skills"/]:::form
    B6 --> B7{"Prepaid?"}:::dec
    B7 -->|"Yes"| B8[/"FORM: fund wallet"/]:::form
    B7 -->|"No"| B9
    B8 --> B9{"Readiness check: everything present?"}:::dec
    B9 -->|"No — checklist shows gaps"| B1
    B9 -->|"Yes"| READY(["WORKSPACE OPERATIONAL"]):::state
  end

  %% ========== 3. REQUEST IN ==========
  subgraph INT["3 · A REQUEST COMES IN"]
    READY --> C0{"Intake channel"}:::dec
    C0 -->|"Manual"| C1[/"FORM: brief + files + deadline + entity"/]:::form
    C0 -->|"Email"| C1b["Dedicated Gmail auto-creates the request"]:::sys
    C0 -->|"Phrase / TMS"| C1c["Phrase project syncs into a request"]:::sys
    C1 --> C2
    C1b --> C2
    C1c --> C2["Ambient AI maps brief to offering + level"]:::sys
    C2 --> C3{"AI confident?"}:::dec
    C3 -->|"Ambiguous — ask 'X or Y?'"| C4["User picks / edits"]:::form
    C3 -->|"Confident"| C5
    C4 --> C5["Requester approves the mapped service"]:::sys
  end

  %% ========== 4. SET UP THE WORK ==========
  subgraph SET["4 · SET UP THE WORK  (SWAT)"]
    C5 --> D1["SWAT creates the assignment"]:::sys
    D1 --> D2{"Invoice code valid? Wallet funded if prepaid?"}:::dec
    D2 -->|"No"| D2x["Blocked: fix pricing / fund wallet"]:::rework
    D2x --> D1
    D2 -->|"Yes, prepaid"| D3["Wallet debited"]:::sys
    D2 -->|"Yes, postpaid"| D4
    D3 --> D4["Split file to parts to activities: TR / PR / QA + Delivery"]:::sys
    D4 --> D5{"Dependencies between activities?"}:::dec
    D5 -->|"Yes"| D6["Chain output to input; add nested sub-assignments"]:::sys
    D5 -->|"No"| D7
    D6 --> D7{"Deliverable, or ongoing service?"}:::dec
    D7 -->|"Ongoing (retainer / BOT)"| D8["Create engagement, bind committed team, open service period"]:::sys
    D7 -->|"Deliverable"| ALLOC
    D8 --> ALLOC
  end

  %% ========== 5. ALLOCATE & PERFORM ==========
  subgraph PERF["5 · ALLOCATE & PERFORM"]
    ALLOC["SWAT allocates activity; AI proposes best-fit performer"]:::sys --> P1{"Performer type?"}:::dec
    P1 -->|"AI agent"| P2["Agent runs (Flip / MT / OCR) then outputs a first pass"]:::sys
    P1 -->|"Human + tool"| P3["License assigned (TR42 / Canva); expert works"]:::form
    P1 -->|"Human"| P4["Notify expert on WhatsApp (one-tap accept)"]:::sys
    P4 --> P5{"Expert accepts?"}:::dec
    P5 -->|"Rejects (reason)"| ALLOC
    P5 -->|"Accepts"| P6["Activity published; request goes LIVE"]:::sys
    P6 --> WK
    P3 --> WK
    WK[/"Expert does the work + logs progress"/]:::form --> WI{"Interim draft to show client?"}:::dec
    WI -->|"Yes"| WI2["Interim delivery; requester reviews / approves"]:::sys
    WI2 --> WK
    WI -->|"Final output"| QA
    P2 --> QA
  end

  %% ========== 6. QA, DELIVER, VERIFY ==========
  subgraph DEL["6 · QA · DELIVER · VERIFY"]
    QA["QA layer reviews the output"]:::sys --> QG{"QA pass?"}:::dec
    QG -->|"Fail — rework"| WK
    QG -->|"Pass"| DA["All activities done; assignment auto-delivers up the tree"]:::sys
    DA --> OB["Owner signs off at the boundary (mandatory review)"]:::sys
    OB --> DC["Deliver to the client's store"]:::sys
    DC --> CAP{"Client approves?"}:::dec
    CAP -->|"Rejects — rework"| WK
    CAP -->|"Approves"| VF{"SWAT TL verifies? (Verify gate)"}:::dec
    VF -->|"Fail — fix"| WK
    VF -->|"Verified"| VOK(["Verified"]):::state
  end

  %% ========== 7. BILL & PAY ==========
  subgraph BILL["7 · BILL & PAY  (only after Verify — rolling)"]
    VOK --> M1["Invoice raised + expert payout"]:::sys
    M1 --> M2{"Ongoing engagement?"}:::dec
    M2 -->|"Yes — next period opens"| D8
    M2 -->|"No"| M3{"Recurring request?"}:::dec
    M3 -->|"Yes — new cycle"| C2
    M3 -->|"No"| DONE(["Delivered · billed · paid"]):::state
    DONE --> GW{"Goodwill revision requested later?"}:::dec
    GW -->|"Yes"| GW2["New linked assignment (no claw-back)"]:::sys
    GW2 --> ALLOC
    GW -->|"No"| CLOSED(["Closed"]):::state
  end

  %% ========== 8. CHANGE HANDLING (can trigger from any live state) ==========
  subgraph CHG["8 · CHANGE HANDLING  (can trigger from any in-flight state)"]
    LIVE(["Any live activity / assignment"]):::state --> CH{"Change type?"}:::dec
    CH -->|"Scope change"| CH1["Re-quote; requester re-approves; TL confirms"]:::rework
    CH -->|"Reassign (expert unavailable)"| CH2["Handover; fee-split; premium from at-fault party"]:::rework
    CH -->|"Pause"| CH3["Assignment paused"]:::rework
    CH -->|"Cancel"| CH4["Sunk work paid per behavior; wallet refund"]:::rework
    CH -->|"Dispute raised"| CH5["Ops resolves; adjust invoice / payout"]:::rework
    CH1 --> RES(["Resume flow"]):::state
    CH2 --> RES
    CH3 --> RES
    CH5 --> RES
    CH4 --> TERM(["Terminated"]):::state
  end
